c:[["$","title","0",{"children":"Chân Kinh Online - Digital Monastery for Entrepreneurs"}],["$","meta","1",{"name":"description","content":"A sanctuary for mindful entrepreneurship. Discover ancient wisdom for modern business success through the teachings of Chân Kinh Online."}],["$","meta","2",{"name":"author","content":"Chân Kinh Online"}],["$","meta","3",{"name":"keywords","content":"Chân Kinh Online,CKO,mindfulness,entrepreneurship,business wisdom,meditation,digital monastery"}],["$","meta","4",{"property":"og:title","content":"Chân Kinh Online - Digital Monastery for Entrepreneurs"}],["$","meta","5",{"property":"og:description","content":"A sanctuary for mindful entrepreneurship. Discover ancient wisdom for modern business success."}],["$","meta","6",{"property":"og:site_name","content":"Chân Kinh Online"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"Chân Kinh Online"}],["$","meta","10",{"name":"twitter:description","content":"Digital Monastery for Entrepreneurs"}],["$","link","11",{"rel":"icon","href":"/logo.svg"}],["$","$L13","12",{}]]
